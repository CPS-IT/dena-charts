{
	"name": "cpsit/dena-charts",
	"description": "Charts allows two display data sets as charts. This is a TYPO3 extension for the DENA project",
	"license": [
		"GPL-2.0+"
	],
	"type": "typo3-cms-extension",
	"keywords": [
		"TYPO3",
		"extension",
		"import",
		"export"
	],
	"authors": [
		{
			"name": "Hannes Lau",
			"role": "Developer"
		},
		{
			"name": "Dirk Wenzel",
			"role": "Developer"
		}
	],
	"require": {
		"maennchen/zipstream-php": "^3.0",
		"typo3/cms-core": "^13.4"
	},
	"require-dev": {
		"armin/editorconfig-cli": "^2.2",
		"ergebnis/composer-normalize": "^2.52",
		"friendsofphp/php-cs-fixer": "^3.95",
		"helmich/typo3-typoscript-lint": "^3.3",
		"mikey179/vfsstream": "~1.6.0",
		"phpstan/phpstan": "^2.1",
		"roave/security-advisories": "dev-master",
		"typo3/coding-standards": "^0.9.0",
		"typo3/testing-framework": "^8.3"
	},
	"autoload": {
		"psr-4": {
			"CPSIT\\DenaCharts\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CPSIT\\DenaCharts\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "dena_charts",
			"web-dir": ".Build/Web"
		}
	},
	"scripts": {
		"post-autoload-dump": [
			"mkdir -p .Build/Web/typo3conf/ext/",
			"mkdir -p .Build/log/coverage/",
			"[ -L .Build/Web/typo3conf/ext/dena_charts || ln -snvf ../../../../. .Build/Web/typo3conf/ext/dena_charts"
		],
		"fix": [
			"@fix:composer",
			"@fix:editorconfig",
			"@fix:php"
		],
		"fix:composer": "@composer normalize",
		"fix:editorconfig": "ec --fix --dir=. -e .Build -e .git -e Resources/Public/JavaScript/Library",
		"fix:php": "php-cs-fixer fix",
		"lint": [
			"@lint:composer",
			"@lint:editorconfig",
			"@lint:php",
			"@lint:typoscript"
		],
		"lint:composer": "@composer normalize --dry-run",
		"lint:editorconfig": "ec --dir=. -e .Build -e .git -e Resources/Public/JavaScript/Library",
		"lint:php": "php-cs-fixer fix --dry-run",
		"lint:typoscript": "typoscript-lint",
		"sca": [
			"@sca:php"
		],
		"sca:php": "phpstan analyse -c phpstan.neon --memory-limit=2G",
		"test": [
			"@test:unit",
			"@test:functional"
		],
		"test:coverage:functional": "phpunit -c Tests/Build/FunctionalTests.xml --fail-on-empty-test-suite --coverage-text --colors=never --coverage-html .Build/log/coverage/html/functional",
		"test:coverage:unit": "phpunit -c Tests/Build/UnitTests.xml --fail-on-empty-test-suite --coverage-text --colors=never --coverage-html .Build/log/coverage/html/unit",
		"test:functional": "phpunit -c Tests/Build/FunctionalTests.xml --fail-on-empty-test-suite",
		"test:unit": "phpunit -c Tests/Build/UnitTests.xml --fail-on-empty-test-suite"
	},
	"scripts-descriptions": {
		"fix": "Fix all code quality issues reported by the registered linters",
		"fix:composer": "Fix all issues in `composer.json`",
		"fix:editorconfig": "Fix all styling issues violating the `.editorconfig` rules",
		"fix:php": "Fix all styling issues violating the configured PHP-CS-Fixer rules",
		"lint": "Run all registered linters to detect code quality issues",
		"lint:composer": "Lint `composer.json` to detect unnormalized styles",
		"lint:editorconfig": "Lint all project files to detect violations of the `.editorconfig` rules",
		"lint:php": "Lint all PHP files to detect coding style violations",
		"lint:typoscript": "Lint all TypoScript and TSconfig files to detect coding style violations",
		"sca": "Run all registered static code analyzers to detect issues in the codebase",
		"sca:php": "Analyze all PHP files by using PHPStan, based on the configured level",
		"test": "Run all test suites",
		"test:coverage:functional": "Run functional tests with text and HTML coverage report",
		"test:coverage:unit": "Run unit tests with text and HTML coverage report",
		"test:functional": "Run the functional test suite",
		"test:unit": "Run the unit test suite"
	}
}
